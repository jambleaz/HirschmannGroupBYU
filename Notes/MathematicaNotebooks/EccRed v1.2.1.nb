Cell[CellGroupData[{

Cell["Fit Waveform", "Section",
 CellChangeTimes->{{3.9580450248347645`*^9, 3.958045033524641*^9}, {
  3.9586494378901367`*^9, 
  3.9586494380181274`*^9}},ExpressionUUID->"71a0974d-0b1d-f14e-8143-\
145b67a8389a"],

Cell[TextData[{
 StyleBox["Nate Note",
  FontWeight->"Bold"],
 ":\n\tI recommend setting ",
 Cell[BoxData[
  FormBox[
   RowBox[{"fitTimeMin", ">=", "100"}], TraditionalForm]],ExpressionUUID->
  "4bf262ca-4618-bf4d-b42c-40039bb80b88"],
 " to avoid the unreliable position data from the initial lapse wave, and I \
recommend setting ",
 Cell[BoxData[
  FormBox[
   RowBox[{"fitTimeMax", "<=", 
    SubscriptBox["t", "ISCO"]}], TraditionalForm]],ExpressionUUID->
  "85382ba0-9a0c-aa44-a01d-e213bcb6094c"],
 ", where ",
 Cell[BoxData[
  FormBox[
   SubscriptBox["t", "ISCO"], TraditionalForm]],ExpressionUUID->
  "e6f64292-9bb5-7f4e-84c8-decf41c51dd0"],
 " is the time at which the BH separation is at the ISCO (typically ",
 Cell[BoxData[
  FormBox[
   RowBox[{"r", "=", 
    RowBox[{"6.5", "M"}]}], TraditionalForm]],ExpressionUUID->
  "b20eb680-bbd8-f04c-8949-402f81a19f6c"],
 " has worked well)."
}], "Text",
 CellChangeTimes->{{3.9787078679496384`*^9, 
  3.978708001705988*^9}},ExpressionUUID->"8fadf18c-5da5-5346-9ebc-\
4c91f79cd8b0"],

Cell[BoxData[
 RowBox[{
  RowBox[{"(*", 
   RowBox[{"NOTE", ":", " ", 
    RowBox[{
    "The", " ", "user", " ", "changes", " ", "these", " ", "parameters", " ", 
     "to", " ", "change", " ", "the", " ", "eccentricity", " ", "fitting", " ",
      "window"}]}], "*)"}], "\[IndentingNewLine]", 
  RowBox[{
   RowBox[{
    RowBox[{"fitTimeMin", "=", "100"}], ";"}], "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"fitTimeMax", "=", "400"}], ";"}], "\[IndentingNewLine]", "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"eccIterDE", "=", 
     RowBox[{
      RowBox[{"myEstimateEccentricityReductionPN35D10DE", "[", 
       RowBox[{"eta", ",", "\[Chi]1", ",", "\[Chi]2", ",", 
        RowBox[{"seplist", "[", 
         RowBox[{"[", "1", "]"}], "]"}], ",", 
        RowBox[{"\[Omega]list", "[", 
         RowBox[{"[", "1", "]"}], "]"}], ",", 
        RowBox[{"\"\<MinTime\>\"", "\[Rule]", "fitTimeMin"}], ",", 
        RowBox[{"\"\<MaxTime\>\"", "\[Rule]", "fitTimeMax"}]}], "]"}], "//", 
      "Quiet"}]}], ";"}], "\[IndentingNewLine]", 
   RowBox[{"(*", 
    RowBox[{"TODO", ":", " ", 
     RowBox[{
     "Maybe", " ", "save", " ", "these", " ", "plots", " ", "to", " ", "the", 
      " ", "directory", " ", "and", " ", "also", " ", "compute", " ", 
      "helpful", " ", "things", " ", "like", " ", 
      SubscriptBox["e", 
       RowBox[{"\[CapitalOmega]", ",", "max"}]], " ", "to", " ", "measure", " ",
       "improvement"}]}], "*)"}], "\[IndentingNewLine]", 
   RowBox[{"(*", 
    RowBox[{
    "I", " ", "think", " ", "if", " ", "I", " ", "want", " ", "to", " ", 
     "plot", " ", "multiple", " ", "iterations", " ", "then", " ", "I", " ", 
     "will", " ", "need", " ", "to", " ", "save", " ", "\[Omega]fitpars", " ",
      "somewhere"}], "*)"}]}]}]], "Input",
