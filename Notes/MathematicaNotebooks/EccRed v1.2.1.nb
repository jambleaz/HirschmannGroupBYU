  3.9580450392124443`*^9}},ExpressionUUID->"d477c960-13de-6e48-9efa-\
9b60d50bb636"],

Cell[BoxData[{
 RowBox[{
  RowBox[{"sign", "=", 
   RowBox[{"-", "1"}]}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"eccT0", "=", 
   RowBox[{"eccIterDE", "/.", 
    RowBox[{"T", "\[Rule]", "0"}]}]}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"e\[CapitalOmega]T0", "=", 
   RowBox[{"eccT0", "[", 
    RowBox[{"[", "1", "]"}], "]"}]}], ";", 
  RowBox[{"\[Delta]e\[CapitalOmega]T0", "=", 
   RowBox[{"eccT0", "[", 
    RowBox[{"[", "2", "]"}], "]"}]}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"\[Phi]T0", "=", 
   RowBox[{"eccT0", "[", 
    RowBox[{"[", "3", "]"}], "]"}]}], ";", 
  RowBox[{"\[Delta]\[Phi]T0", "=", 
   RowBox[{"eccT0", "[", 
    RowBox[{"[", "4", "]"}], "]"}]}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"AmpT0", "=", 
   RowBox[{"eccT0", "[", 
    RowBox[{"[", "5", "]"}], "]"}]}], ";", 
  RowBox[{"\[Delta]AmpT0", "=", 
   RowBox[{"eccT0", "[", 
    RowBox[{"[", "6", "]"}], "]"}]}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"\[Lambda]r1pnRes", "=", 
    RowBox[{"1", "/", 
     RowBox[{"\[Lambda]r1PNResSum", "[", 
      RowBox[{"AmpT0", ",", "\[Phi]T0", ",", 
       RowBox[{"Pr35PN", "[", 
        RowBox[{"dist", ",", "q0", ",", "\[Chi]1", ",", "\[Chi]2", ",", "1"}],
         "]"}], ",", 
       RowBox[{"m\[Omega]r35SPN", "[", 
        RowBox[{"dist", ",", "q0", ",", "\[Chi]1", ",", "\[Chi]2", ",", "1"}],
         "]"}], ",", "dist", ",", "eta", ",", "1"}], "]"}]}]}], ";"}], " ", 
  RowBox[{"(*", " ", 
   RowBox[{
    RowBox[{"Eq", ".", " ", 
