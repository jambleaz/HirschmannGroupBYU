Cell[CellGroupData[{

Cell["Nova Derivatives", "Subsection",
 CellChangeTimes->{{3.9636649998437767`*^9, 3.9636650002221622`*^9}, {
  3.9787071854941216`*^9, 
  3.978707186623949*^9}},ExpressionUUID->"44c49b7c-5471-9d4e-9b73-\
1bd5b532f42d"],

Cell[BoxData[
 RowBox[{
  RowBox[{"NovaDeriv", "[", 
   RowBox[{"xList_", ",", "yList_", ",", "h_"}], "]"}], ":=", 
  RowBox[{"Module", "[", 
   RowBox[{
    RowBox[{"{", 
     RowBox[{"aNList", ",", "n", ",", "r", ",", "dxInterior", ",", "dxList"}],
      "}"}], ",", "\[IndentingNewLine]", 
    RowBox[{
     RowBox[{"n", "=", "20"}], ";", "\[IndentingNewLine]", 
     RowBox[{"(*", 
      RowBox[{"Nova", " ", "stencil"}], "*)"}], "\[IndentingNewLine]", 
     RowBox[{"aNList", "=", 
      RowBox[{
       FractionBox["1", 
        RowBox[{"n", "*", 
         RowBox[{"(", 
          RowBox[{"n", "+", "1"}], ")"}], "*", 
         RowBox[{
          RowBox[{"(", 
           RowBox[{
            RowBox[{"2", "*", "n"}], "+", "1"}], ")"}], "/", "3"}]}]], "*", 
       RowBox[{"Table", "[", 
        RowBox[{"i", ",", 
         RowBox[{"{", 
          RowBox[{"i", ",", 
           RowBox[{"-", "n"}], ",", "n", ",", "1"}], "}"}]}], "]"}]}]}], ";", 
     "\[IndentingNewLine]", "\[IndentingNewLine]", 
     RowBox[{"(*", 
      RowBox[{"Hybrid", " ", "stencil"}], "*)"}], "\[IndentingNewLine]", 
     RowBox[{"(*", 
      RowBox[{
       RowBox[{"aNList", "=", 
        RowBox[{
         FractionBox["1", "252"], "*", 
         RowBox[{"{", 
          RowBox[{"22", ",", 
           RowBox[{"-", "67"}], ",", 
           RowBox[{"-", "58"}], ",", "0", ",", "58", ",", "67", ",", 
           RowBox[{"-", "22"}]}], "}"}]}]}], ";"}], "*)"}], 
     "\[IndentingNewLine]", "\[IndentingNewLine]", 
     RowBox[{"(*", 
      RowBox[{"Stencil", " ", "width"}], "*)"}], "\[IndentingNewLine]", 
     RowBox[{"r", "=", 
      RowBox[{"Floor", "[", 
       RowBox[{
        RowBox[{"Length", "[", "aNList", "]"}], "/", "2"}], "]"}]}], ";", 
     "\[IndentingNewLine]", "\[IndentingNewLine]", 
     RowBox[{"(*", 
      RowBox[{"Derivative", " ", "estimate"}], "*)"}], "\[IndentingNewLine]", 
     RowBox[{"dxInterior", "=", 
      RowBox[{"Table", "[", 
       RowBox[{
        RowBox[{
         FractionBox["1", "h"], "*", 
         RowBox[{"Sum", "[", 
          RowBox[{
           RowBox[{
            RowBox[{"aNList", "[", 
             RowBox[{"[", 
              RowBox[{"k", "+", "r", "+", "1"}], "]"}], "]"}], "*", 
            RowBox[{"yList", "[", 
             RowBox[{"[", 
              RowBox[{"i", "+", "k"}], "]"}], "]"}]}], ",", 
           RowBox[{"{", 
            RowBox[{"k", ",", 
             RowBox[{"-", "r"}], ",", "r"}], "}"}]}], "]"}]}], ",", 
        RowBox[{"{", 
         RowBox[{"i", ",", 
          RowBox[{"r", "+", "1"}], ",", 
          RowBox[{
           RowBox[{"Length", "@", "yList"}], "-", "r"}]}], "}"}]}], "]"}]}], ";",
      "\[IndentingNewLine]", "\[IndentingNewLine]", 
     RowBox[{"(*", 
      RowBox[{"Extrapolate", " ", "to", " ", "boundary", " ", "points"}], 
      "*)"}], "\[IndentingNewLine]", 
     RowBox[{"dxList", "=", 
      RowBox[{"Join", "[", 
       RowBox[{
        RowBox[{"ConstantArray", "[", 
         RowBox[{
          RowBox[{"First", "@", "dxInterior"}], ",", "r"}], "]"}], ",", 
        "dxInterior", ",", 
        RowBox[{"ConstantArray", "[", 
         RowBox[{
          RowBox[{"Last", "@", "dxInterior"}], ",", "r"}], "]"}]}], 
       "]"}]}]}]}], "\[IndentingNewLine]", "\[IndentingNewLine]", 
   "]"}]}]], "Input",
 CellChangeTimes->{{3.9622682847565613`*^9, 3.962268383553875*^9}, 
   3.962268499979721*^9, {3.962269385323107*^9, 3.9622693899505787`*^9}, {
   3.962269523630331*^9, 3.962269538002825*^9}, {3.962269579923113*^9, 
   3.962269611265547*^9}, {3.9622696464580555`*^9, 3.9622697035145607`*^9}, {
   3.9622793656858063`*^9, 3.962279370496805*^9}, {3.9622794046883926`*^9, 
   3.9622794561370106`*^9}, {3.9622797874275913`*^9, 3.9622798133202343`*^9}, 
   3.9622798998798313`*^9},
 CellLabel->
  "In[688]:=",ExpressionUUID->"1a8bf21a-90b7-b445-9399-889e2b8d6743"]
}, Closed]],

Cell[CellGroupData[{

Cell["Find velocity and angular velocity", "Subsection",
 CellChangeTimes->{{3.963665003127886*^9, 3.963665003376726*^9}, {
  3.9787071917595787`*^9, 
  3.9787071994353943`*^9}},ExpressionUUID->"08fa47da-f9b0-7644-88bb-\
96d737054b0f"],

Cell[BoxData[
 RowBox[{
  RowBox[{"(*", 
   RowBox[{
    RowBox[{
    "Initialize", " ", "lists", " ", "for", " ", "time", " ", "spacing", " ", 
     "dt"}], ",", " ", 
    RowBox[{"angular", " ", "position", " ", "\[Phi]"}], ",", " ", 
    RowBox[{"angular", " ", "velocity", " ", "\[Omega]"}], ",", " ", 
    RowBox[{"and", " ", "separation", " ", "distance"}]}], "*)"}], 
  "\[IndentingNewLine]", 
  RowBox[{
   RowBox[{
    RowBox[{"dt", "=", 
     RowBox[{
      RowBox[{"tList", "[", 
       RowBox[{"[", "2", "]"}], "]"}], "-", 
      RowBox[{"tList", "[", 
       RowBox[{"[", "1", "]"}], "]"}]}]}], ";"}], "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"\[Phi]list", "=", 
     RowBox[{"{", "}"}]}], ";"}], "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"\[Omega]list", "=", 
     RowBox[{"{", "}"}]}], ";"}], "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"seplist", "=", 
     RowBox[{"{", "}"}]}], ";"}], "\[IndentingNewLine]", 
   "\[IndentingNewLine]", 
   RowBox[{"(*", 
    RowBox[{
    "Take", " ", "the", " ", "discrete", " ", "xyz", " ", "positions", " ", 
     "of", " ", "the", " ", "two", " ", "BHs", " ", "and", " ", "interpolate",
      " ", "to", " ", "produce", " ", "continuous", " ", "functions", " ", 
     "for", " ", "their", " ", "trajectories"}], "*)"}], "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"ixyz1", "=", 
     RowBox[{"Interpolation", "/@", 
      RowBox[{"{", 
       RowBox[{
        RowBox[{"Transpose", "@", 
         RowBox[{"{", 
          RowBox[{"tList", ",", "BHX1"}], "}"}]}], ",", 
        RowBox[{"Transpose", "@", 
         RowBox[{"{", 
          RowBox[{"tList", ",", "BHY1"}], "}"}]}], ",", 
        RowBox[{"Transpose", "@", 
         RowBox[{"{", 
          RowBox[{"tList", ",", "BHZ1"}], "}"}]}]}], "}"}]}]}], ";"}], "\n", 
   RowBox[{
    RowBox[{"ixyz2", "=", 
     RowBox[{"Interpolation", "/@", 
      RowBox[{"{", 
       RowBox[{
        RowBox[{"Transpose", "@", 
         RowBox[{"{", 
          RowBox[{"tList", ",", "BHX2"}], "}"}]}], ",", 
        RowBox[{"Transpose", "@", 
         RowBox[{"{", 
          RowBox[{"tList", ",", "BHY2"}], "}"}]}], ",", 
        RowBox[{"Transpose", "@", 
         RowBox[{"{", 
          RowBox[{"tList", ",", "BHZ2"}], "}"}]}]}], "}"}]}]}], ";"}], 
   "\[IndentingNewLine]", 
   RowBox[{"(*", 
    RowBox[{
     RowBox[{
     "Makes", " ", "a", " ", "discrete", " ", "list", " ", "of", " ", "the", " ",
       "radial", " ", "distance", " ", "to", " ", "each", " ", "BH"}], ";", 
     " ", 
     RowBox[{"these", " ", "are", " ", "currently", " ", "unused"}]}], "*)"}],
    "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"irad1", " ", "=", " ", 
     RowBox[{"Table", "[", 
      RowBox[{
       RowBox[{"Norm", "[", 
        RowBox[{
         RowBox[{"ixyz1", "[", 
          RowBox[{"[", "i", "]"}], "]"}], "[", "t", "]"}], "]"}], ",", 
       RowBox[{"{", 
        RowBox[{"i", ",", "1", ",", 
         RowBox[{"Length", "@", "ixyz1"}]}], "}"}]}], "]"}]}], ";"}], "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"irad2", " ", "=", " ", 
     RowBox[{"Table", "[", 
      RowBox[{
       RowBox[{"Norm", "[", 
        RowBox[{
         RowBox[{"ixyz2", "[", 
          RowBox[{"[", "i", "]"}], "]"}], "[", "t", "]"}], "]"}], ",", 
       RowBox[{"{", 
        RowBox[{"i", ",", "1", ",", 
         RowBox[{"Length", "@", "ixyz2"}]}], "}"}]}], "]"}]}], ";"}], 
   "\[IndentingNewLine]", 
   RowBox[{"(*", 
    RowBox[{
     RowBox[{"Initialize", " ", "the", " ", "time", " ", "domain"}], ",", " ", 
     RowBox[{"start", " ", "time"}], ",", " ", 
     RowBox[{
     "and", " ", "end", " ", "time", " ", "of", " ", "the", " ", "run"}]}], 
    "*)"}], "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"domain", "=", 
     RowBox[{
      RowBox[{"ixyz1", "[", 
       RowBox[{"[", "1", "]"}], "]"}], "[", "\"\<Domain\>\"", "]"}]}], ";"}], 
   "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"tMIN", "=", 
     RowBox[{"First", "@", 
      RowBox[{"domain", "[", 
       RowBox[{"[", "1", "]"}], "]"}]}]}], ";"}], "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"tMAX", "=", 
     RowBox[{"Last", "@", 
      RowBox[{"domain", "[", 
       RowBox[{"[", "1", "]"}], "]"}]}]}], ";"}], "\[IndentingNewLine]", 
   RowBox[{"(*", 
    RowBox[{
    "Make", " ", "a", " ", "discrete", " ", "list", " ", "of", " ", "time", " ",
      "steps", " ", "spaced", " ", "by", " ", "the", " ", "constant", " ", 
     "spacing", " ", "dt"}], "*)"}], "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"txyz", "=", 
     RowBox[{"Table", "[", 
      RowBox[{"i", ",", 
       RowBox[{"{", 
        RowBox[{"i", ",", "tMIN", ",", "tMAX", ",", "dt"}], "}"}]}], "]"}]}], 
    ";"}], "\[IndentingNewLine]", 
   RowBox[{"(*", 
    RowBox[{
    "Compute", " ", "the", " ", "BH", " ", "separation", " ", "vector"}], 
    "*)"}], "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"iX", "=", 
     RowBox[{"Table", "[", 
      RowBox[{
       RowBox[{
        RowBox[{
         RowBox[{"ixyz1", "[", 
          RowBox[{"[", "i", "]"}], "]"}], "[", "t", "]"}], "-", 
        RowBox[{
         RowBox[{"ixyz2", "[", 
          RowBox[{"[", "i", "]"}], "]"}], "[", "t", "]"}]}], ",", 
       RowBox[{"{", 
        RowBox[{"i", ",", "1", ",", 
         RowBox[{"Length", "@", "ixyz1"}]}], "}"}]}], "]"}]}], ";"}], 
   "\[IndentingNewLine]", "\[IndentingNewLine]", "\[IndentingNewLine]", 
   RowBox[{"(*", 
    RowBox[{
    "Take", " ", "the", " ", "derivative", " ", "of", " ", "the", " ", 
     "separation", " ", "vector", " ", "to", " ", "find", " ", "the", " ", 
     "velocity", " ", "vector", " ", "of", " ", "the", " ", "EOB", " ", 
     "system"}], "*)"}], "\[IndentingNewLine]", 
   RowBox[{"(*", 
    RowBox[{"NOTE", ":", " ", 
     RowBox[{
     "We", " ", "are", " ", "taking", " ", "the", " ", "derivative", " ", 
      "using", " ", "a", " ", "Nova", " ", "derivative", " ", "since", " ", 
      "it", " ", "provides", " ", "a", " ", "much", " ", "smoother", " ", 
      "angular", " ", "velocity", " ", "curve"}]}], "*)"}], 
   "\[IndentingNewLine]", 
   RowBox[{"(*", 
    RowBox[{"ivxyz", "=", 
     RowBox[{"D", "[", 
      RowBox[{"iX", ",", "t"}], "]"}]}], "*)"}], "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"ivxyz", "=", 
     RowBox[{"Transpose", "@", 
      RowBox[{"Table", "[", "\[IndentingNewLine]", 
       RowBox[{
        RowBox[{"NovaDeriv", "[", 
         RowBox[{"txyz", ",", 
          RowBox[{"Table", "[", 
           RowBox[{
            RowBox[{
             RowBox[{"iX", "[", 
              RowBox[{"[", "k", "]"}], "]"}], "/.", 
             RowBox[{"{", 
              RowBox[{"t", "->", 
               RowBox[{"txyz", "[", 
                RowBox[{"[", "j", "]"}], "]"}]}], "}"}]}], ",", 
            "\[IndentingNewLine]", 
            RowBox[{"{", 
             RowBox[{"j", ",", "1", ",", 
              RowBox[{"Length", "@", "txyz"}]}], "}"}]}], "]"}], ",", "dt"}], 
         "]"}], ",", "\[IndentingNewLine]", 
        RowBox[{"{", 
         RowBox[{"k", ",", "1", ",", 
          RowBox[{"Length", "@", "iX"}]}], "}"}]}], "]"}]}]}], ";"}], 
   "\[IndentingNewLine]", "\[IndentingNewLine]", 
   RowBox[{"(*", 
    RowBox[{
    "Discretize", " ", "the", " ", "separation", " ", "and", " ", "velocity", 
     " ", "vectors"}], "*)"}], "\[IndentingNewLine]", 
   RowBox[{"(*", 
    RowBox[{
     RowBox[{"NOTE", ":", " ", 
      RowBox[{"By", " ", "the", " ", "new", " ", "method"}]}], ",", " ", 
     RowBox[{"ivxyz", " ", "is", " ", "already", " ", "discretized"}]}], 
    "*)"}], "\[IndentingNewLine]", 
   RowBox[{"(*", 
    RowBox[{"vtab", "=", 
     RowBox[{"Table", "[", 
      RowBox[{
       RowBox[{"ivxyz", "/.", 
        RowBox[{"{", 
         RowBox[{"t", "\[Rule]", 
          RowBox[{"txyz", "[", 
           RowBox[{"[", "j", "]"}], "]"}]}], "}"}]}], ",", 
       RowBox[{"{", 
        RowBox[{"j", ",", "1", ",", 
         RowBox[{"Length", "@", "txyz"}]}], "}"}]}], "]"}]}], "*)"}], "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"vtab", "=", "ivxyz"}], ";"}], "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"xtab", "=", 
     RowBox[{"Table", "[", 
      RowBox[{
       RowBox[{"iX", "/.", 
        RowBox[{"{", 
         RowBox[{"t", "\[Rule]", 
          RowBox[{"txyz", "[", 
           RowBox[{"[", "j", "]"}], "]"}]}], "}"}]}], ",", 
       RowBox[{"{", 
        RowBox[{"j", ",", "1", ",", 
         RowBox[{"Length", "@", "txyz"}]}], "}"}]}], "]"}]}], ";"}], 
   "\[IndentingNewLine]", 
   RowBox[{"(*", 
    RowBox[{
    "Compute", " ", "the", " ", "separation", " ", "based", " ", "on", " ", 
     "the", " ", "separation", " ", "vector"}], "*)"}], "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"rsep", "=", 
     RowBox[{"Norm", "/@", "xtab"}]}], ";"}], "\[IndentingNewLine]", 
   RowBox[{"(*", 
    RowBox[{
     RowBox[{
     "Compute", " ", "the", " ", "angular", " ", "velocity", " ", "using", " ",
       "\[Omega]"}], "=", 
     RowBox[{"|", 
      FractionBox[
       RowBox[{
        StyleBox["r",
         FontWeight->"Bold"], "\[Cross]", 
        StyleBox["v",
         FontWeight->"Bold"]}], 
       RowBox[{"|", 
        StyleBox["r",
         FontWeight->"Bold"], 
        SuperscriptBox["|", "2"]}]], "|"}]}], "*)"}], "\[IndentingNewLine]", 
   RowBox[{"(*", 
    RowBox[{
    "Note", " ", "the", " ", "inclusion", " ", "of", " ", "the", " ", 
     "\[Epsilon]", " ", "factor", " ", "here", " ", "to", " ", "prevent", " ",
      "a", " ", "zero", " ", "denominator"}], "*)"}], "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"\[Omega]Norm", "=", 
     RowBox[{"Norm", "/@", 
      RowBox[{"Table", "[", 
       RowBox[{
        RowBox[{
         RowBox[{"Cross", "[", 
          RowBox[{
           RowBox[{"xtab", "[", 
            RowBox[{"[", "j", "]"}], "]"}], ",", 
           RowBox[{"vtab", "[", 
            RowBox[{"[", "j", "]"}], "]"}]}], "]"}], "/", 
         RowBox[{"(", 
          RowBox[{
           RowBox[{
            RowBox[{"rsep", "[", 
             RowBox[{"[", "j", "]"}], "]"}], "*", 
            RowBox[{"rsep", "[", 
             RowBox[{"[", "j", "]"}], "]"}]}], "+", "\[Epsilon]"}], ")"}]}], ",", 
        RowBox[{"{", 
         RowBox[{"j", ",", "1", ",", 
          RowBox[{"Length", "@", "txyz"}]}], "}"}]}], "]"}]}]}], ";"}], 
   "\[IndentingNewLine]", 
   RowBox[{"(*", 
    RowBox[{
    "Interpolate", " ", "over", " ", "the", " ", "separation", " ", "and", " ",
      "angular", " ", "velocity"}], "*)"}], "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"i\[Omega]ET", "=", 
     RowBox[{"Interpolation", "[", 
      RowBox[{
       RowBox[{"{", 
        RowBox[{"txyz", ",", "\[Omega]Norm"}], "}"}], "//", "Transpose"}], 
      "]"}]}], ";"}], "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"isep", "=", 
     RowBox[{"Interpolation", "[", 
      RowBox[{
       RowBox[{"{", 
        RowBox[{"txyz", ",", "rsep"}], "}"}], "//", "Transpose"}], "]"}]}], 
    ";"}], "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"\[Omega]list", "=", 
     RowBox[{"AppendTo", "[", 
      RowBox[{"\[Omega]list", ",", "i\[Omega]ET"}], "]"}]}], ";"}], "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"seplist", "=", 
     RowBox[{"AppendTo", "[", 
      RowBox[{"seplist", ",", "isep"}], "]"}]}], ";"}]}]}]], "Input",
 CellChangeTimes->{{3.9580455948590164`*^9, 3.958045612287834*^9}, {
   3.958045644263462*^9, 3.9580456512190742`*^9}, {3.9584741821189384`*^9, 
