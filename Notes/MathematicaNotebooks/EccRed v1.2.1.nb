Cell[CellGroupData[{

Cell["Formulas for \[Lambda]t, pr, pt, px, py", "Subsubsection",
 CellChangeTimes->{{3.707306471933839*^9, 
  3.7073064876317058`*^9}},ExpressionUUID->"8d27d13d-bca9-ad48-b53d-\
098b01573165"],

Cell[BoxData[
 RowBox[{
  RowBox[{"\[Delta]rmas", "[", 
   RowBox[{
   "Amp_", ",", "R0_", ",", "\[CapitalOmega]0_", ",", "q_", ",", 
    "\[Gamma]_"}], "]"}], ":=", 
  RowBox[{
   FractionBox[
    RowBox[{"Amp", " ", "R0"}], 
    RowBox[{"2", " ", "\[CapitalOmega]0"}]], "-", 
   FractionBox[
    RowBox[{"3", " ", "Amp", " ", 
     RowBox[{"(", 
      RowBox[{"3", "+", 
       RowBox[{"7", " ", "q"}], "+", 
       RowBox[{"3", " ", 
        SuperscriptBox["q", "2"]}]}], ")"}], " ", "\[Gamma]"}], 
    RowBox[{"4", " ", 
     SuperscriptBox[
      RowBox[{"(", 
       RowBox[{"1", "+", "q"}], ")"}], "2"], " ", 
     "\[CapitalOmega]0"}]]}]}]], "Input",
 CellChangeTimes->{{3.716008655324131*^9, 3.716008672378004*^9}},
 CellLabel->
  "In[642]:=",ExpressionUUID->"1c331b96-3bec-cb4a-b435-4453a9412e64"],

Cell[BoxData[
 RowBox[{
  RowBox[{"\[Lambda]t1PNLin", "[", 
   RowBox[{"ecc_", ",", "sign_", ",", "R0_", ",", "\[Eta]_"}], "]"}], ":=", 
  RowBox[{"1", "+", 
   FractionBox[
    RowBox[{"sign", "*", 
     RowBox[{"Abs", "[", "ecc", "]"}]}], "2"], "+", 
   RowBox[{"sign", "*", 
    RowBox[{"Abs", "[", "ecc", "]"}], " ", 
    RowBox[{"(", 
     RowBox[{
      RowBox[{"-", 
       FractionBox["1", "R0"]}], "-", 
      FractionBox["\[Eta]", 
       RowBox[{"2", " ", "R0"}]]}], ")"}]}]}]}]], "Input",
 CellChangeTimes->{{3.700826026060093*^9, 3.700826164287609*^9}, {
   3.700826416344336*^9, 3.700826416834722*^9}, {3.700828359539874*^9, 
   3.700828360639327*^9}, {3.700884243030436*^9, 3.700884415452899*^9}, {
   3.700884464637315*^9, 3.700884501719012*^9}, {3.701685506324895*^9, 
   3.701685557644264*^9}, {3.701685785872198*^9, 3.701685847154387*^9}, {
   3.701686012700218*^9, 3.701686020197014*^9}, {3.701686073842464*^9, 
   3.701686091910439*^9}, {3.701686340430784*^9, 3.7016863436883993`*^9}, {
   3.701686398557619*^9, 3.701686438993383*^9}, 3.707306392140637*^9, {
   3.707449861352652*^9, 3.707449948979581*^9}, {3.707454923159709*^9, 
   3.7074550335862827`*^9}, {3.70745508517556*^9, 3.7074550895282373`*^9}, {
   3.722084111995344*^9, 3.722084112796871*^9}, {3.744539966610339*^9, 
   3.744539967392108*^9}},
 CellLabel->
  "In[643]:=",ExpressionUUID->"ee0738b8-fd85-b644-b220-421d5156b245"],

Cell[BoxData[{
 RowBox[{
  RowBox[{"pr", "[", 
   RowBox[{"x_", ",", "y_", ",", "Px_", ",", "Py_"}], "]"}], ":=", 
  FractionBox[
   RowBox[{
    RowBox[{"Px", " ", "x"}], "+", 
    RowBox[{"Py", " ", "y"}]}], 
   SqrtBox[
    RowBox[{
     SuperscriptBox["x", "2"], "+", 
     SuperscriptBox["y", "2"]}]]]}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"p\[Theta]", "[", 
   RowBox[{"x_", ",", "y_", ",", "Px_", ",", "Py_"}], "]"}], ":=", 
  RowBox[{
   RowBox[{"x", " ", "Py"}], " ", "-", 
   RowBox[{"y", " ", "Px"}]}]}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"pt", "[", 
   RowBox[{"x_", ",", "y_", ",", "Px_", ",", "Py_"}], "]"}], ":=", 
  FractionBox[
   RowBox[{"(", 
    RowBox[{
     RowBox[{"x", " ", "Py"}], " ", "-", 
     RowBox[{"y", " ", "Px"}]}], ")"}], 
   SqrtBox[
    RowBox[{
     SuperscriptBox["x", "2"], "+", 
     SuperscriptBox["y", "2"]}]]]}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"Px", "[", 
    RowBox[{"x_", ",", "y_", ",", "Pr_", ",", "Pt_"}], "]"}], ":=", 
   RowBox[{"-", 
    FractionBox[
     RowBox[{
      RowBox[{
       RowBox[{"-", "Pr"}], " ", "x"}], "+", 
      RowBox[{"Pt", " ", "y"}]}], 
     SqrtBox[
      RowBox[{
       SuperscriptBox["x", "2"], "+", 
       SuperscriptBox["y", "2"]}]]]}]}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"Py", "[", 
    RowBox[{"x_", ",", "y_", ",", "Pr_", ",", "Pt_"}], "]"}], ":=", 
   RowBox[{"-", 
    FractionBox[
     RowBox[{
      RowBox[{
       RowBox[{"-", "Pt"}], " ", "x"}], "-", 
      RowBox[{"Pr", " ", "y"}]}], 
     SqrtBox[
      RowBox[{
       SuperscriptBox["x", "2"], "+", 
       SuperscriptBox["y", "2"]}]]]}]}], ";"}]}], "Input",
 CellChangeTimes->{{3.700888337047339*^9, 3.700888403298398*^9}, {
  3.710471162437796*^9, 3.710471163090056*^9}},
 CellLabel->
  "In[644]:=",ExpressionUUID->"264c78c5-09af-9949-94f1-ecd00e37ee8f"],

Cell[BoxData[
 RowBox[{"solspxpy", "=", 
  RowBox[{"Flatten", "@", 
   RowBox[{"Solve", "[", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{
       RowBox[{
        RowBox[{"pr", "[", 
         RowBox[{"x", ",", "y", ",", "px", ",", "py"}], "]"}], "\[Equal]", 
        "Pr"}], ",", 
       RowBox[{
        RowBox[{"pt", "[", 
         RowBox[{"x", ",", "y", ",", "px", ",", "py"}], "]"}], "\[Equal]", 
        "Pt"}]}], "}"}], ",", 
     RowBox[{"{", 
      RowBox[{"px", ",", "py"}], "}"}]}], "]"}]}]}]], "Input",
 CellChangeTimes->{{3.700888267489986*^9, 3.700888321125823*^9}},
 CellLabel->
  "In[649]:=",ExpressionUUID->"ce7f0e3c-3427-b54b-bac3-7fcd938aa337"],

Cell[TextData[StyleBox["We write two small functions for given Pr and Pt -> \
Px and Py and viceversa.",
 FontColor->RGBColor[1, 0, 0]]], "Text",
 CellChangeTimes->{{3.70730824831693*^9, 3.707308310750056*^9}, {
  3.7073083982973967`*^9, 
  3.707308433137846*^9}},ExpressionUUID->"32538946-2c6b-3b4e-a20a-\
9b24164c48be"],

Cell[BoxData[
 RowBox[{
  RowBox[{"PxPyToPrPt", "[", 
   RowBox[{"x_", ",", "y_", ",", "Px_", ",", "Py_"}], "]"}], ":=", 
  RowBox[{"Module", "[", 
   RowBox[{
    RowBox[{"{", 
     RowBox[{"Pr", " ", ",", "Pt"}], " ", "}"}], ",", "\[IndentingNewLine]", 
    RowBox[{
     RowBox[{"Pr", "=", 
      RowBox[{"pr", "[", 
       RowBox[{"x", ",", "y", ",", "Px", ",", "Py"}], "]"}]}], ";", 
     "\[IndentingNewLine]", 
     RowBox[{"Pt", "=", 
      RowBox[{"pt", "[", 
       RowBox[{"x", ",", "y", ",", "Px", ",", "Py"}], "]"}]}], ";", 
     "\[IndentingNewLine]", 
     RowBox[{"{", 
      RowBox[{"Pr", ",", "Pt"}], "}"}]}]}], "\[IndentingNewLine]", 
